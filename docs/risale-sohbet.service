[Unit]
Description=Risale-i Nur sohbet sayfası (S12: hesaplar ve sohbet servisi; Caddy arkasında: risalemcp.com/sohbet/)
After=network-online.target
Wants=network-online.target

[Service]
User=risale
WorkingDirectory=/home/risale/risale-mcp
# .env: ANTHROPIC_API_KEY, SCW_SECRET_KEY, SCW_PROJECT_ID, VOYAGE_API_KEY (env.py okur); bağımlılık `uv sync --extra sohbet`
ExecStart=/home/risale/risale-mcp/.venv/bin/python -m risale_mcp.sohbet serve --port 8010
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/risale/risale-mcp/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
