[Unit]
Description=Risale-i Nur MCP sunucusu (OAuth + hesapsız erişim, Caddy arkasında: mcp.risalemcp.com)
After=network-online.target
Wants=network-online.target

[Service]
User=risale
WorkingDirectory=/home/risale/risale-mcp
ExecStart=/home/risale/risale-mcp/.venv/bin/risale-mcp --transport streamable-http --public-url https://mcp.risalemcp.com --anonymous
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/risale/risale-mcp/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
