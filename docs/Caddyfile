# Uzak sunucunun /etc/caddy/Caddyfile'ı (kopyası; asıl sunucuda). scripts/gecis.sh yazar.
# Sertifikaları Caddy Let's Encrypt'ten kendisi alır ve yeniler; Cloudflare'de kayıtlar "DNS only" (gri bulut):
# proxy uzun MCP bağlantılarını 100 sn'de keser ve Anthropic'in isteklerine bot doğrulaması gösterebilir.

# Bağlayıcı: MCP sunucusu, giriş sayfası ve OAuth uç noktaları (uygulama yalnızca 127.0.0.1:8000'de dinler).
mcp.risalemcp.com {
	# Ana adres tanıtım sitesine gider: simge servisleri (Claude, dizin) ana sayfada simge bağlantısını arar.
	redir / https://risalemcp.com/ 302
	# OpenAI eklenti dizininin alan adı doğrulaması: portalın verdiği jeton düz metin olarak
	# (scripts/sunucu.sh openai-challenge <jeton> yazar). Dosya yoksa 404; MCP'ye gitmez.
	handle /.well-known/openai-apps-challenge {
		root * /var/www/mcp-challenge
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	# Hadis bağdaştırıcısı: aynı makinede ayrı süreç (docs/risale-mcp-hadis.server.service, 127.0.0.1:8001), o da
	# /mcp'de dinler. /hadis/<anahtar> onun gizli hata ayıklama adresidir (/mcp/<anahtar>).
	handle /hadis {
		rewrite * /mcp
		reverse_proxy 127.0.0.1:8001
	}
	handle_path /hadis/* {
		rewrite * /mcp{path}
		reverse_proxy 127.0.0.1:8001
	}
	# Tefsir bağdaştırıcısı: ayrı makine (tefsir-mcp, Tailscale 100.98.98.62; docs/risale-mcp-tefsir.server.service,
	# scripts/tefsir-sunucu.sh), yalnız Tailscale'den erişilir; o da /mcp'de dinler, Host başlığı korunur.
	handle /tefsir {
		rewrite * /mcp
		reverse_proxy 100.98.98.62:8002
	}
	handle_path /tefsir/* {
		rewrite * /mcp{path}
		reverse_proxy 100.98.98.62:8002
	}
	# Klasik eserler bağdaştırıcısı (E2.4): tefsirle aynı makinede, 8003 (docs/risale-mcp-klasik.server.service,
	# PROFIL=klasik scripts/tefsir-sunucu.sh).
	handle /klasik {
		rewrite * /mcp
		reverse_proxy 100.98.98.62:8003
	}
	handle_path /klasik/* {
		rewrite * /mcp{path}
		reverse_proxy 100.98.98.62:8003
	}
	reverse_proxy 127.0.0.1:8000
}

# Hadis, tefsir ve klasik bağdaştırıcılarının kendi alt alan adları (S4.6, 2026-11-16): OpenAI doğrulaması alan adı
# başınadır, sunucular ayrı yönlendirilebilir. Her sunucu kökünde kendi simgesini ve küçük bir sayfa verir (Claude'un
# arayüzü simgeyi yine kök alan adından, risalemcp.com'dan alır), /mcp ve /mcp/<anahtar> doğrudan
# ona gider. mcp.risalemcp.com/hadis gibi eski yollar yukarıda sürer (eklemiş olanlar için). OpenAI'nin alan adı
# doğrulaması her alt alan adında ayrı dosyadır (scripts/sunucu.sh openai-challenge <jeton> [hadis|tefsir|klasik]).
hadis.risalemcp.com {
	handle /.well-known/openai-apps-challenge {
		root * /var/www/mcp-challenge-hadis
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	reverse_proxy 127.0.0.1:8001
}

tefsir.risalemcp.com {
	handle /.well-known/openai-apps-challenge {
		root * /var/www/mcp-challenge-tefsir
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	reverse_proxy 100.98.98.62:8002
}

klasik.risalemcp.com {
	handle /.well-known/openai-apps-challenge {
		root * /var/www/mcp-challenge-klasik
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	reverse_proxy 100.98.98.62:8003
}

# S13.15: Âyinedâr, çatı ve projeler (PLANLAR.md › S13.15 (a); DNS Cloudflare'de "DNS only", alt alan adları CNAME
# ile köke). Şimdilik hepsi depodaki site-ayinedar/'ın "hazırlanıyor" sayfası (scripts/deploy.sh gönderir); projeler
# taşındıkça kendi bloklarını alır: chat (S13.15.4), read ve lab (S13.15.5), kök (S13.15.6), connect (S13.15.7).
ayinedar.org, chat.ayinedar.org, read.ayinedar.org, lab.ayinedar.org, connect.ayinedar.org {
	encode gzip
	header X-Robots-Tag "noindex, nofollow"
	root * /var/www/ayinedar
	try_files {path} /index.html
	file_server
}

# www ve .com asıl adrese yönlenir (S13.15 (b): asıl adres .org)
www.ayinedar.org, ayinedar.com, www.ayinedar.com {
	redir https://ayinedar.org{uri} 301
}

# Tanıtım sitesi, belgeler ve gizlilik politikası: depodaki site/ klasörü (scripts/deploy.sh gönderir).
risalemcp.com {
	# S12: sohbet sayfasının cevap akışı (Server-Sent Events) sıkıştırılmaz: sıkıştırma akışı parça parça göndermez
	@sikistir not path /sohbet/*
	encode @sikistir gzip
	# S12: sohbet sayfası (src/risale_mcp/sohbet.py, docs/risale-sohbet.service, 127.0.0.1:8010): hesap sayfaları,
	# sohbet, API. Oturumu uygulama kendisi denetler (çerez yalnız /sohbet/ yolunda; davetli bölümün hesapları değil).
	# Akış tamponlanmaz (flush_interval -1); uzun cevaplar için okuma zaman aşımı yok (varsayılan).
	redir /sohbet /sohbet/ 308
	handle /sohbet/* {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy 127.0.0.1:8010 {
			flush_interval -1
		}
	}
	# İşârât'ın usul özeti 2026-11-14'e kadar /taslak/'taydı (bağlantısı paylaşıldı): yeni yerine
	redir /taslak/isarat-usulu.html /isarat-usul/ 301
	redir /taslak/isarat-usulu.pdf /isarat-usul/isarat-usulu.pdf 301
	# S5: girişli taslak çalışma bölümü (âyet masası). Sayfalar /var/www/ozel/taslak/ altında statik dosyadır,
	# site/ klasöründe değildir. Her istekte giriş servisine sorulur (src/risale_mcp/site_auth.py,
	# docs/risale-taslak.service, 127.0.0.1:8009): oturum yoksa giriş sayfasına yönlendirir.
	handle /taslak/giris {
		reverse_proxy 127.0.0.1:8009
	}
	handle /taslak/cikis {
		reverse_proxy 127.0.0.1:8009
	}
	# girişli kişinin adı (sayfa işaretlere okuyucu adı olarak yazar); oturum yoksa 401
	handle /taslak/ben {
		reverse_proxy 127.0.0.1:8009
	}
	# S7.2: ar-ge masasının sunucu tarafı (src/risale_mcp/masa.py; aynı servis): okumalar, kararlar, notlar. Oturumu
	# (ya da makine jetonunu) uygulama kendisi denetler.
	handle /taslak/api/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8009
	}
	# S7.3: okuma platformu (davetli; aynı hesaplar, `oku` kapsamı yalnız buraya girer). Dosyalar
	# /var/www/ozel/taslak/oku/ altında (D5 sunucusunun kısıtlı anahtarı yalnız taslak klasörüne yazar); /oku/… oraya
	# çevrilir, giriş servisi /taslak/oku/… yolunu `oku` kapsamına da açar.
	redir /oku /oku/ 308
	# S10: davet bağlantısı (okuyucu parolasını koyar); girişsiz açılır, jetonu servis denetler
	handle /oku/davet/* {
		header Cache-Control "no-store"
		header Referrer-Policy "no-referrer"
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy 127.0.0.1:8009
	}
	handle /oku/* {
		rewrite * /taslak{uri}
		forward_auth 127.0.0.1:8009 {
			uri /_auth
		}
		header {
			Cache-Control "private, no-cache"
			X-Robots-Tag "noindex, nofollow"
			Referrer-Policy "same-origin"
		}
		root * /var/www/ozel
		file_server
	}
	handle /taslak* {
		forward_auth 127.0.0.1:8009 {
			uri /_auth
		}
		header {
			Cache-Control "private, no-store"
			X-Robots-Tag "noindex, nofollow"
			Referrer-Policy "same-origin"
		}
		root * /var/www/ozel
		file_server
	}
	handle {
		root * /var/www/risalemcp
		file_server
	}
}

