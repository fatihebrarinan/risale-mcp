# Uzak sunucunun /etc/caddy/Caddyfile'ı (kopyası; asıl sunucuda). scripts/gecis.sh yazar.
# Sertifikaları Caddy Let's Encrypt'ten kendisi alır ve yeniler; Cloudflare'de kayıtlar "DNS only" (gri bulut):
# proxy uzun MCP bağlantılarını 100 sn'de keser ve Anthropic'in isteklerine bot doğrulaması gösterebilir.

# Bağlayıcı: MCP sunucusu, giriş sayfası ve OAuth uç noktaları (uygulama yalnızca 127.0.0.1:8000'de dinler).
mcp.risalemcp.com {
	# Ana adres tanıtım sitesine gider: simge servisleri (Claude, dizin) ana sayfada simge bağlantısını arar.
	redir / https://risalemcp.com/ 302
	# OpenAI eklenti dizininin alan adı doğrulaması: portalın verdiği jeton düz metin olarak
	# (scripts/sunucu.sh openai-challenge <jeton> yazar). Dosya yoksa 404; MCP'ye gitmez.
	handle /.well-known/openai-apps-challenge {
		root * /var/www/mcp-challenge
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	# Hadis bağdaştırıcısı: aynı makinede ayrı süreç (docs/risale-mcp-hadis.server.service, 127.0.0.1:8001), o da
	# /mcp'de dinler. /hadis/<anahtar> onun gizli hata ayıklama adresidir (/mcp/<anahtar>).
	handle /hadis {
		rewrite * /mcp
		reverse_proxy 127.0.0.1:8001
	}
	handle_path /hadis/* {
		rewrite * /mcp{path}
		reverse_proxy 127.0.0.1:8001
	}
	# Tefsir bağdaştırıcısı: ayrı makine (tefsir-mcp, Tailscale 100.98.98.62; docs/risale-mcp-tefsir.server.service,
	# scripts/tefsir-sunucu.sh), yalnız Tailscale'den erişilir; o da /mcp'de dinler, Host başlığı korunur.
	handle /tefsir {
		rewrite * /mcp
		reverse_proxy 100.98.98.62:8002
	}
	handle_path /tefsir/* {
		rewrite * /mcp{path}
		reverse_proxy 100.98.98.62:8002
	}
	# Klasik eserler bağdaştırıcısı (E2.4): tefsirle aynı makinede, 8003 (docs/risale-mcp-klasik.server.service,
	# PROFIL=klasik scripts/tefsir-sunucu.sh).
	handle /klasik {
		rewrite * /mcp
		reverse_proxy 100.98.98.62:8003
	}
	handle_path /klasik/* {
		rewrite * /mcp{path}
		reverse_proxy 100.98.98.62:8003
	}
	reverse_proxy 127.0.0.1:8000
}

# Tanıtım sitesi, belgeler ve gizlilik politikası: depodaki site/ klasörü (scripts/deploy.sh gönderir).
risalemcp.com {
	root * /var/www/risalemcp
	encode gzip
	file_server
}

