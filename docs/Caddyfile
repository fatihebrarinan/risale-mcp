# Uzak sunucunun /etc/caddy/Caddyfile'ı (kopyası; asıl sunucuda). scripts/gecis.sh yazar.
# Sertifikaları Caddy Let's Encrypt'ten kendisi alır ve yeniler; Cloudflare'de kayıtlar "DNS only" (gri bulut):
# proxy uzun MCP bağlantılarını 100 sn'de keser ve Anthropic'in isteklerine bot doğrulaması gösterebilir.

# Bağlayıcı: MCP sunucusu, giriş sayfası ve OAuth uç noktaları (uygulama yalnızca 127.0.0.1:8000'de dinler).
mcp.risalemcp.com {
	# Ana adres tanıtım sitesine gider: simge servisleri (Claude, dizin) ana sayfada simge bağlantısını arar.
	redir / https://risalemcp.com/ 302
	# OpenAI eklenti dizininin alan adı doğrulaması: portalın verdiği jeton düz metin olarak
	# (scripts/sunucu.sh openai-challenge <jeton> yazar). Dosya yoksa 404; MCP'ye gitmez.
	handle /.well-known/openai-apps-challenge {
		root * /var/www/mcp-challenge
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	# Hadis bağdaştırıcısı: aynı makinede ayrı süreç (docs/risale-mcp-hadis.server.service, 127.0.0.1:8001), o da
	# /mcp'de dinler. /hadis/<anahtar> onun gizli hata ayıklama adresidir (/mcp/<anahtar>).
	handle /hadis {
		rewrite * /mcp
		reverse_proxy 127.0.0.1:8001
	}
	handle_path /hadis/* {
		rewrite * /mcp{path}
		reverse_proxy 127.0.0.1:8001
	}
	# Tefsir bağdaştırıcısı: ayrı makine (tefsir-mcp, Tailscale 100.98.98.62; docs/risale-mcp-tefsir.server.service,
	# scripts/tefsir-sunucu.sh), yalnız Tailscale'den erişilir; o da /mcp'de dinler, Host başlığı korunur.
	handle /tefsir {
		rewrite * /mcp
		reverse_proxy 100.98.98.62:8002
	}
	handle_path /tefsir/* {
		rewrite * /mcp{path}
		reverse_proxy 100.98.98.62:8002
	}
	# Klasik eserler bağdaştırıcısı (E2.4): tefsirle aynı makinede, 8003 (docs/risale-mcp-klasik.server.service,
	# PROFIL=klasik scripts/tefsir-sunucu.sh).
	handle /klasik {
		rewrite * /mcp
		reverse_proxy 100.98.98.62:8003
	}
	handle_path /klasik/* {
		rewrite * /mcp{path}
		reverse_proxy 100.98.98.62:8003
	}
	reverse_proxy 127.0.0.1:8000
}

# Hadis, tefsir ve klasik bağdaştırıcılarının kendi alt alan adları (S4.6, 2026-11-16): OpenAI doğrulaması alan adı
# başınadır, sunucular ayrı yönlendirilebilir. Her sunucu kökünde kendi simgesini ve küçük bir sayfa verir (Claude'un
# arayüzü simgeyi yine kök alan adından, risalemcp.com'dan alır), /mcp ve /mcp/<anahtar> doğrudan
# ona gider. mcp.risalemcp.com/hadis gibi eski yollar yukarıda sürer (eklemiş olanlar için). OpenAI'nin alan adı
# doğrulaması her alt alan adında ayrı dosyadır (scripts/sunucu.sh openai-challenge <jeton> [hadis|tefsir|klasik]).
hadis.risalemcp.com {
	handle /.well-known/openai-apps-challenge {
		root * /var/www/mcp-challenge-hadis
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	reverse_proxy 127.0.0.1:8001
}

tefsir.risalemcp.com {
	handle /.well-known/openai-apps-challenge {
		root * /var/www/mcp-challenge-tefsir
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	reverse_proxy 100.98.98.62:8002
}

klasik.risalemcp.com {
	handle /.well-known/openai-apps-challenge {
		root * /var/www/mcp-challenge-klasik
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	reverse_proxy 100.98.98.62:8003
}

# S13.15: Âyinedâr, çatı ve projeler (PLANLAR.md › S13.15 (a); DNS Cloudflare'de "DNS only", alt alan adları CNAME
# ile köke). S13.15.6 (2026-11-27): kök çatı sitesidir (depodaki site-ayinedar/, scripts/site-uret.py üretir,
# scripts/deploy.sh gönderir): ana sayfa, Yenilikler, Çalışmalar, belgeler; arama motorlarına açık.
ayinedar.org {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	root * /var/www/ayinedar
	file_server
	# Caddy 2.6: handle_errors durum kodu almaz, eşleyiciyle
	handle_errors {
		@yok expression {err.status_code} == 404
		handle @yok {
			root * /var/www/ayinedar
			rewrite * /404.html
			file_server
		}
	}
}

# Eklentilerin tanıtımı (S13.22'de buraya taşınacak); o zamana kadar risalemcp.com'a, geçici
connect.ayinedar.org {
	redir https://risalemcp.com{uri} 302
}

# S13.15.5: okuma platformu ve ar-ge masası (2026-11-27'ye kadar risalemcp.com/oku/ ve /taslak/). Dosyalar statik:
# masa /var/www/ozel/taslak/, platform onun oku/ klasörü (D5 sunucusunun kısıtlı anahtarı yalnız oraya yazar).
# Giriş servisi (src/risale_mcp/site_auth.py, docs/risale-taslak.service, 127.0.0.1:8009) her iki bölümde aynı
# yolları verir (/giris, /cikis, /ben, /api/…; davet yalnız platformda); hangi bölüm olduğunu X-Bolum başlığı söyler
# (üstüne yazılır: istemci değiştiremez). Çerez her alt alan adının kendisinindir. Önceden üretilmiş sayfalar
# /taslak/api/… ve /taslak/ben'i çağırır: /taslak önekinin atılmasıyla onlar da çalışır. Âyinedâr simgeleri girişsiz.
read.ayinedar.org {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	header X-Robots-Tag "noindex, nofollow"
	@eski path /taslak /taslak/*
	uri @eski strip_prefix /taslak
	route {
		@simge path /favicon.ico /icon-kucuk.svg /icon.svg /apple-touch-icon.png
		handle @simge {
			root * /var/www/ayinedar
			file_server
		}
		# S10: davet bağlantısı (okuyucu parolasını koyar); girişsiz açılır, jetonu servis denetler
		handle /davet/* {
			header Cache-Control "no-store"
			header Referrer-Policy "no-referrer"
			reverse_proxy 127.0.0.1:8009 {
				header_up X-Bolum read
			}
		}
		@servis path /giris /cikis /ben /api/*
		handle @servis {
			header Cache-Control "no-store"
			reverse_proxy 127.0.0.1:8009 {
				header_up X-Bolum read
			}
		}
		handle {
			forward_auth 127.0.0.1:8009 {
				uri /_auth
				header_up X-Bolum read
			}
			header Cache-Control "private, no-cache"
			header Referrer-Policy "same-origin"
			root * /var/www/ozel/taslak/oku
			file_server
		}
	}
}

lab.ayinedar.org {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	header X-Robots-Tag "noindex, nofollow"
	@eski path /taslak /taslak/*
	uri @eski strip_prefix /taslak
	route {
		@simge path /favicon.ico /icon-kucuk.svg /icon.svg /apple-touch-icon.png
		handle @simge {
			root * /var/www/ayinedar
			file_server
		}
		@servis path /giris /cikis /ben /api/*
		handle @servis {
			header Cache-Control "no-store"
			reverse_proxy 127.0.0.1:8009 {
				header_up X-Bolum lab
			}
		}
		# Yazı önizlemesi (/onizleme/) sitenin sayfalarıdır, stil ve resimleri kökten ister: masada olmayan dosya
		# sitede varsa oradan, girişsiz (zaten herkese açık)
		# S13.15.6: yazılar çatıda (ayinedar.org), önizleme onun stilini kullanır
		@site {
			not file {
				root /var/www/ozel/taslak
				try_files {path} {path}/index.html
			}
			file {
				root /var/www/ayinedar
				try_files {path}
			}
		}
		handle @site {
			root * /var/www/ayinedar
			file_server
		}
		handle {
			forward_auth 127.0.0.1:8009 {
				uri /_auth
				header_up X-Bolum lab
			}
			header Cache-Control "private, no-store"
			header Referrer-Policy "same-origin"
			root * /var/www/ozel/taslak
			file_server
		}
	}
}

# S13.15.4: sohbet (src/risale_mcp/sohbet.py, docs/risale-sohbet.service, 127.0.0.1:8010; 2026-11-27'ye kadar
# risalemcp.com/sohbet/). Hesap sayfaları, sohbet, API; oturumu uygulama kendisi denetler. Güvenlik başlıkları
# (CSP …) uygulamadadır, HSTS burada. Cevap akışı (Server-Sent Events) sıkıştırılmaz ve tamponlanmaz
# (flush_interval -1); uzun cevaplar için okuma zaman aşımı yok (varsayılan). S13.15.6: arama motorlarına açık
# (tanıtımlı sayfalar; kod, hesap ve çevrimdışı sayfaları uygulamada noindex, robots.txt ve site haritası uygulamada).
chat.ayinedar.org {
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:8010 {
		flush_interval -1
	}
}

# www ve .com asıl adrese yönlenir (S13.15 (b): asıl adres .org)
www.ayinedar.org, ayinedar.com, www.ayinedar.com {
	redir https://ayinedar.org{uri} 301
}

# Tanıtım sitesi, belgeler ve gizlilik politikası: depodaki site/ klasörü (scripts/deploy.sh gönderir).
risalemcp.com {
	encode gzip
	# S13.15.4: sohbet chat.ayinedar.org'a taşındı (2026-11-27); eski adresler aynı yola yönlenir
	# (/sohbet/gizlilik → chat.ayinedar.org/gizlilik). 308: istek yöntemi korunur.
	redir /sohbet https://chat.ayinedar.org/ 308
	handle_path /sohbet/* {
		redir https://chat.ayinedar.org{uri} 308
	}
	# İşârât'ın usul özeti 2026-11-14'e kadar /taslak/'taydı (bağlantısı paylaşıldı): yeni yerine (S13.15.6'dan beri çatıda)
	redir /taslak/isarat-usulu.html https://ayinedar.org/isarat-usul/ 301
	redir /taslak/isarat-usulu.pdf https://ayinedar.org/isarat-usul/isarat-usulu.pdf 301
	# S13.15.6: Yenilikler, Çalışmalar ve usul özeti çatıya taşındı (2026-11-27); eski adresler aynı yola
	@cati path /yenilikler.html /yenilikler.xml /yenilikler/* /calismalar.html /calismalar.xml /calismalar/* /isarat-usul /isarat-usul/*
	redir @cati https://ayinedar.org{uri} 308
	# S13.15.5: masa lab.ayinedar.org'a, okuma platformu read.ayinedar.org'a taşındı (2026-11-27); eski adresler aynı
	# yola (/oku/davet/<jeton> → read.ayinedar.org/davet/<jeton>; adres çubuğundaki #… tarayıcıda kalır)
	redir /oku https://read.ayinedar.org/ 308
	handle_path /oku/* {
		redir https://read.ayinedar.org{uri} 308
	}
	redir /taslak https://lab.ayinedar.org/ 308
	handle_path /taslak/* {
		redir https://lab.ayinedar.org{uri} 308
	}
	handle {
		root * /var/www/risalemcp
		file_server
	}
}
